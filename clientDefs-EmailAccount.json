                            "type": "isTrue",
                            "attribute": "useImap"
                        }
                    ]
                }
            },
            "hosts": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "isTrue",
                            "attribute": "useImap"
                        }
                    ]
                }
            },
            "security": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "isTrue",
                            "attribute": "useImap"
                        }
                    ]
                }
            },
            "port": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "isTrue",
                            "attribute": "useImap"
                        }
                    ]
                }
            },
            "username": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "isTrue",
